<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alanone.mwb-mac-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>__EXECUTABLE_PATH__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Respawn after a crash or "Restart App" (which exits with code 1),
         but not after the menu's Quit (a clean exit). ThrottleInterval
         keeps a fast-crashing binary from being relaunched in a tight loop. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>3</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/mwb-mac-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/mwb-mac-bridge.err.log</string>
</dict>
</plist>
