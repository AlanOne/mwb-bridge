<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the companion's protocol code on any OS (it has no Windows
       dependencies): `dotnet run` here. Exits non-zero on a failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../companion/Protocol.cs" />
    <Compile Include="../companion/Log.cs" />
    <Compile Include="../companion/Names.cs" />
    <Compile Include="../companion/SetupCheck.cs" />
  </ItemGroup>
</Project>
